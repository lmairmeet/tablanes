{
  "manifest_version": 3,
  "name": "TabLanes",
  "version": "1.0.0",
  "description": "A fast, local Trello-style board on every new tab. Stored in a local SQLite database.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
